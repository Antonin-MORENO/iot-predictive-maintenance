# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# --- Simulator -> IoT Hub (device connection string) ---
# IoT Hub > Devices > turbofan-engine-1 > Primary connection string
AZURE_IOT_CONNECTION_STRING=HostName=xxx.azure-devices.net;DeviceId=xxx;SharedAccessKey=xxx

# --- Consumer: read the IoT Hub message stream ---
# IoT Hub > Hub settings > Built-in endpoints > Event Hub-compatible endpoint
IOTHUB_EVENTHUB_CONNECTION_STRING=Endpoint=sb://xxx.servicebus.windows.net/;SharedAccessKeyName=service;SharedAccessKey=xxx;EntityPath=xxx

# --- Consumer: scoring endpoint (Azure Function URL with key) ---
# Function App > Functions > score > Get Function Url
SCORING_ENDPOINT_URL=https://func-turbofan-antonin.azurewebsites.net/api/score?code=xxx
